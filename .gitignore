# Your data, not the program. Nabatt keeps these in %LOCALAPPDATA%\Nabatt once
# installed; these entries cover the case where it is running portable, or from
# this folder during development.
logs/
*.csv
logger-errors.log
app-logger-errors.log

# The app window's private Chrome profile.
.appprofile/

# Generated by install.ps1, with absolute paths baked in for this machine.
Nabatt.vbs
Nabatt-boot.vbs
Nabatt-uninstall.vbs
launch.vbs
portable.txt

# Build output of make-icon.py that is not worth versioning.
web/_icon-preview.png

# Windows / editor noise
Thumbs.db
desktop.ini
.vscode/
__pycache__/
*.pyc
